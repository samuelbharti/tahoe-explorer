# Example environment file. Copy to `.Renviron` (which is git-ignored) and fill
# in real values. R reads `.Renviron` automatically on startup.

# Directory holding downloaded Tahoe-100M metadata parquet files.
# Defaults to "data" (gitignored). Falls back to synthetic fixtures if empty.
# TAHOE_METADATA_DIR=data

# Set to 1 to query the 2.29 GB cell-level obs table directly from HuggingFace
# (slower) instead of downloading it. Leave unset to use a local file/fixture.
# TAHOE_OBS_REMOTE=0
