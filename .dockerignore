# Tahoe metadata. Mirrors .gitignore: the small curated tables ship so the
# container shows real numbers, the 2.29 GB cell-level obs table never does
# (set TAHOE_OBS_REMOTE=1 to query it from HuggingFace instead).
data/*
!data/fixtures/
!data/fixtures/**
!data/cell_line_metadata.parquet
!data/cell_line_variants.parquet
!data/drug_metadata.parquet
!data/gene_metadata.parquet
!data/obs_cell_grid.parquet
!data/sample_metadata.parquet

# Dev tooling / configs not needed in the image
template.yml
.pre-commit-config.yaml
air.toml
.lintr
.markdownlint.json
.markdownlintignore
.Renviron
.Renviron.example
CONTRIBUTING.md
CODE_OF_CONDUCT.md
CHANGELOG.md
